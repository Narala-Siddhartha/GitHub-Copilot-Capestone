{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/session-init.js",
        "timeout": 15
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/audit-log.js",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/pre-tool-guard.js",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/post-tool-validate.js",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/audit-log.js",
        "timeout": 10
      }
    ]
  }
}
